---
import Layout from '../layouts/Layout.astro';
---

<Layout title="HACKATHON 2025">
    <!-- Navigation -->
    <nav class="fixed top-0 w-full bg-white backdrop-blur-sm z-50 border-b border-gray-100">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center space-x-2">
                    <img src="/UTEC-Logo.jpg" alt="UTEC Logo" class="h-8"/>
                    <span class="font-bold text-[#003B71] text-lg">HACKATHON 2025</span>
                </div>
                <div class="hidden md:flex space-x-8 items-center">
                    <a href="#inicio" class="text-gray-700 hover:text-[#003B71] transition-colors">Inicio</a>
                    <a href="#acerca" class="text-gray-700 hover:text-[#003B71] transition-colors">Acerca</a>
                    <a href="#tematica" class="text-gray-700 hover:text-[#003B71] transition-colors">Temática</a>
                    <a href="#premios" class="text-gray-700 hover:text-[#003B71] transition-colors">Premios</a>
                    <a href="#registro" class="bg-[#003B71] text-white px-4 py-2 rounded-lg hover:bg-[#002548] transition-colors">Registrarse</a>
                </div>
                <button class="md:hidden text-gray-700" id="mobile-menu-btn">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>

            <!-- Mobile Menu -->
            <div class="md:hidden hidden" id="mobile-menu">
                <div class="px-2 pt-2 pb-3 space-y-1 bg-white border-t border-gray-100">
                    <a href="#inicio" class="block px-3 py-2 text-gray-700 hover:text-[#003B71] transition-colors">Inicio</a>
                    <a href="#acerca" class="block px-3 py-2 text-gray-700 hover:text-[#003B71] transition-colors">Acerca</a>
                    <a href="#tematica" class="block px-3 py-2 text-gray-700 hover:text-[#003B71] transition-colors">Temática</a>
                    <a href="#premios" class="block px-3 py-2 text-gray-700 hover:text-[#003B71] transition-colors">Premios</a>
                    <a href="#registro" class="block mx-3 my-2 bg-[#003B71] text-white px-4 py-2 rounded-lg hover:bg-[#002548] transition-colors text-center">Registrarse</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="inicio" class="min-h-screen flex items-center relative overflow-hidden">
        <!-- Animated Background -->
        <div class="absolute inset-0 bg-gradient-to-br from-[#001a2e] via-[#003B71] to-[#0056a4]"></div>

        <!-- Animated Particles -->
        <div class="absolute inset-0">
            <div class="particle particle-1"></div>
            <div class="particle particle-2"></div>
            <div class="particle particle-3"></div>
            <div class="particle particle-4"></div>
            <div class="particle particle-5"></div>
            <div class="particle particle-6"></div>
        </div>

        <!-- Floating Code Elements -->
        <div class="absolute inset-0 overflow-hidden">
            <div class="code-float code-1">{ '<hackathon>' }</div>
            <div class="code-float code-2">{ '{ innovation }' }</div>
            <div class="code-float code-3">{ '</future>' }</div>
            <div class="code-float code-4">{ 'const utec = "2025"' }</div>
            <div class="code-float code-5">{ '=> sustainability' }</div>
            <div class="code-float code-6">{ 'function solve() {' }</div>
            <div class="code-float code-7">{ 'npm install hope' }</div>
            <div class="code-float code-8">{ 'git commit -m "save world"' }</div>
            <div class="code-float code-9">{ 'while(true) { innovate(); }' }</div>
            <div class="code-float code-10">{ 'import { future } from "peru"' }</div>
            <div class="code-float code-11">{ '<div className="change">' }</div>
            <div class="code-float code-12">{ 'let impact = sustainable()' }</div>
            <div class="code-float code-13">{ '// TODO: change the world' }</div>
            <div class="code-float code-14">{ 'export default Innovation' }</div>
            <div class="code-float code-15">{ 'console.log("Hello Peru!"' }</div>
            <div class="code-float code-16">{ 'async function build() {' }</div>
            <div class="code-float code-17">{ 'return <Solution />' }</div>
            <div class="code-float code-18">{ '} catch(problems) {' }</div>
        </div>

        <!-- Geometric Shapes -->
        <div class="absolute inset-0">
            <div class="geometric-shape shape-1"></div>
            <div class="geometric-shape shape-2"></div>
            <div class="geometric-shape shape-3"></div>
            <div class="geometric-shape shape-4"></div>
        </div>

        <!-- Grid Pattern Overlay -->
        <div class="absolute inset-0 opacity-10">
            <div class="grid-pattern"></div>
        </div>

        <!-- Content -->
        <div class="container mx-auto px-4 relative z-10">
            <div class="max-w-4xl mx-auto text-center text-white">
                <div class="animate-fade-in-up">
                    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight">
                        <span class="inline-block animate-pulse-slow">HACKATHON</span><br>
                        <span class="inline-block animate-pulse-slow">2025</span>
                    </h1>
                </div>

                <div class="animate-fade-in-up animation-delay-300">
                    <p class="text-lg sm:text-xl md:text-2xl mb-8 opacity-90 max-w-2xl mx-auto px-4">
                        Transformando ideas en soluciones innovadoras para el desarrollo sostenible del Perú
                    </p>
                </div>

                <div class="animate-fade-in-up animation-delay-600">
                    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12 px-4">
                        <div class="info-card w-full sm:w-auto">
                            <span class="text-sm opacity-80">Inicio:</span>
                            <div class="text-lg sm:text-xl font-bold">21 Junio</div>
                            <div class="text-lg sm:text-xl">6:00 PM</div>
                        </div>
                        <div class="info-card w-full sm:w-auto">
                            <span class="text-sm opacity-80">Fin:</span>
                            <div class="text-lg sm:text-xl font-bold">22 Junio</div>
                            <div class="text-lg sm:text-xl">6:00 PM</div>
                        </div>
                    </div>
                </div>

                <div class="animate-fade-in-up animation-delay-900">
                    <div id="countdown" class="text-xl sm:text-2xl font-bold mb-8 animate-pulse px-4"></div>
                    <a href="#registro" class="cta-button">
                        Registrar Equipo
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="acerca" class="py-16 sm:py-20 bg-white">
        <div class="container mx-auto px-4">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-12 sm:mb-16">
                    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-800 mb-6">¿Qué es el UTEC Hackathon?</h2>
                    <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto px-4">
                        Un evento de 48 horas donde estudiantes, desarrolladores y emprendedores se unen para crear
                        soluciones tecnológicas innovadoras que aborden los desafíos de sostenibilidad en el Perú.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
                    <div class="text-center p-6 sm:p-8 rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors">
                        <div class="w-16 h-16 bg-[#003B71] rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl sm:text-2xl font-bold text-gray-800 mb-2">42 Equipos</h3>
                        <p class="text-gray-600">Registrados hasta ahora</p>
                    </div>

                    <div class="text-center p-6 sm:p-8 rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors">
                        <div class="w-16 h-16 bg-[#003B71] rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl sm:text-2xl font-bold text-gray-800 mb-2">48 Horas</h3>
                        <p class="text-gray-600">De desarrollo intensivo</p>
                    </div>

                    <div class="text-center p-6 sm:p-8 rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors">
                        <div class="w-16 h-16 bg-[#003B71] rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl sm:text-2xl font-bold text-gray-800 mb-2">S/. 17,500</h3>
                        <p class="text-gray-600">En premios totales</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Theme Section -->
    <section id="tematica" class="py-16 sm:py-20 bg-gradient-to-r from-gray-50 to-blue-50">
        <div class="container mx-auto px-4">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-12 sm:mb-16">
                    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-800 mb-6">Temática</h2>
                    <div class="inline-block bg-[#003B71] text-white px-6 sm:px-8 py-3 sm:py-4 rounded-full text-lg sm:text-xl md:text-2xl font-bold mb-8">
                        Diagram as Code
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                    <div class="bg-white p-6 sm:p-8 rounded-xl <shado></shado>w-lg hover:shadow-xl transition-shadow">
                        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"></path>
                            </svg>
                        </div>
                        <h3 class="text-lg sm:text-xl font-bold text-gray-800 mb-3">Gestión del Agua</h3>
                        <p class="text-gray-600 text-sm sm:text-base">Soluciones para el manejo eficiente y sostenible de recursos hídricos</p>
                    </div>

                    <div class="bg-white p-6 sm:p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
                        <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                        </div>
                        <h3 class="text-lg sm:text-xl font-bold text-gray-800 mb-3">Energías Renovables</h3>
                        <p class="text-gray-600 text-sm sm:text-base">Innovaciones en energía solar, eólica y otras fuentes limpias</p>
                    </div>

                    <div class="bg-white p-6 sm:p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
                        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                            </svg>
                        </div>
                        <h3 class="text-lg sm:text-xl font-bold text-gray-800 mb-3">Agricultura Sostenible</h3>
                        <p class="text-gray-600 text-sm sm:text-base">Tecnologías para optimizar la producción agrícola responsable</p>
                    </div>

                    <div class="bg-white p-6 sm:p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
                        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                            </svg>
                        </div>
                        <h3 class="text-lg sm:text-xl font-bold text-gray-800 mb-3">Movilidad Urbana</h3>
                        <p class="text-gray-600 text-sm sm:text-base">Sistemas de transporte inteligente y sostenible</p>
                    </div>

                    <div class="bg-white p-6 sm:p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
                        <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                            </svg>
                        </div>
                        <h3 class="text-lg sm:text-xl font-bold text-gray-800 mb-3">Economía Circular</h3>
                        <p class="text-gray-600 text-sm sm:text-base">Plataformas para reutilización y reciclaje de materiales</p>
                    </div>

                    <div class="bg-white p-6 sm:p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
                        <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <h3 class="text-lg sm:text-xl font-bold text-gray-800 mb-3">Salud Ambiental</h3>
                        <p class="text-gray-600 text-sm sm:text-base">Monitoreo y mejora de la calidad ambiental</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Prizes Section -->
    <section id="premios" class="py-16 sm:py-20 bg-white">
        <div class="container mx-auto px-4">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-12 sm:mb-16">
                    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-800 mb-6">Premios</h2>
                    <p class="text-lg sm:text-xl text-gray-600">Reconocemos la excelencia e innovación</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
                    <!-- First Place -->
                    <div class="relative bg-gradient-to-br from-yellow-400 to-yellow-600 p-6 sm:p-8 rounded-2xl text-white transform hover:scale-105 transition-transform">
                        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
                            <div class="bg-yellow-500 rounded-full p-3">
                                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="text-center pt-8">
                            <h3 class="text-xl sm:text-2xl font-bold mb-4">Primer Lugar</h3>
                            <div class="text-3xl sm:text-4xl font-bold mb-4">S/. 10,000</div>
                            <ul class="space-y-2 text-sm">
                                <li>• Incubación en UTEC Ventures</li>
                                <li>• Mentoría especializada</li>
                                <li>• Acceso a laboratorios UTEC</li>
                                <li>• Certificación oficial</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Second Place -->
                    <div class="relative bg-gradient-to-br from-gray-300 to-gray-500 p-6 sm:p-8 rounded-2xl text-white transform hover:scale-105 transition-transform">
                        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
                            <div class="bg-gray-400 rounded-full p-3">
                                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="text-center pt-8">
                            <h3 class="text-xl sm:text-2xl font-bold mb-4">Segundo Lugar</h3>
                            <div class="text-3xl sm:text-4xl font-bold mb-4">S/. 5,000</div>
                            <ul class="space-y-2 text-sm">
                                <li>• Mentoría por 6 meses</li>
                                <li>• Créditos AWS/Azure</li>
                                <li>• Networking con empresas</li>
                                <li>• Certificación oficial</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Third Place -->
                    <div class="relative bg-gradient-to-br from-orange-400 to-orange-600 p-6 sm:p-8 rounded-2xl text-white transform hover:scale-105 transition-transform">
                        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
                            <div class="bg-orange-500 rounded-full p-3">
                                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="text-center pt-8">
                            <h3 class="text-xl sm:text-2xl font-bold mb-4">Tercer Lugar</h3>
                            <div class="text-3xl sm:text-4xl font-bold mb-4">S/. 2,500</div>
                            <ul class="space-y-2 text-sm">
                                <li>• Recursos cloud por 1 año</li>
                                <li>• Cursos especializados</li>
                                <li>• Kit de desarrollo</li>
                                <li>• Certificación oficial</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Registration Section -->
    <section id="registro" class="py-16 sm:py-20 bg-gradient-to-r from-[#003B71] to-[#0056a4] text-white">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto text-center">
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6">¿Listo para el HACKATHON?</h2>
                <p class="text-lg sm:text-xl mb-8 opacity-90 px-4">
                    Crea, colabora y compite junto a tu equipo.
                </p>

                <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 sm:p-8 mb-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 text-center">
                        <div>
                            <div class="text-2xl sm:text-3xl font-bold mb-2">20 Junio</div>
                            <div class="opacity-80 text-sm sm:text-base">Fecha límite de registro</div>
                        </div>
                        <div>
                            <div class="text-2xl sm:text-3xl font-bold mb-2">3 personas</div>
                            <div class="opacity-80 text-sm sm:text-base">Por equipo</div>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                    <a href="#" class="w-full sm:w-auto bg-white text-[#003B71] font-bold py-4 px-8 rounded-lg hover:bg-gray-100 transition-all transform hover:scale-105 text-center">
                        Registrar Equipo
                    </a>
                    <a href="#" class="w-full sm:w-auto border-2 border-white text-white font-bold py-4 px-8 rounded-lg hover:bg-white hover:text-[#003B71] transition-all text-center">
                        Descargar Bases
                    </a>
                </div>
            </div>
        </div>
    </section>

    <script>
        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }

                // Close mobile menu if open
                const mobileMenu = document.getElementById('mobile-menu');
                if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
                    mobileMenu.classList.add('hidden');
                }
            });
        });

        // Countdown timer
        function updateCountdown() {
            const hackathonDate = new Date('June 21, 2025 18:00:00').getTime();
            const now = new Date().getTime();
            const timeLeft = hackathonDate - now;

            if (timeLeft <= 0) {
                document.getElementById('countdown').textContent = '¡El hackathon ha comenzado!';
                return;
            }

            const days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
            const hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));

            document.getElementById('countdown').textContent =
                `Faltan: ${ days } días, ${ hours } horas, ${ minutes } minutos`;
        }

        updateCountdown();
        setInterval(updateCountdown, 60000);

        // Mobile menu toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuBtn?.addEventListener('click', () => {
            mobileMenu?.classList.toggle('hidden');
        });

        // Add scroll effect to navigation
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 100) {
                nav.classList.add('shadow-lg');
            } else {
                nav.classList.remove('shadow-lg');
            }
        });
    </script>
</Layout>
