---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Podium from '../components/Podium.astro';
import TeamsList from '../components/TeamsList.astro';
import Footer from '../components/Footer.astro';
import results from '../data/results.json';
---

<Layout title="Resultados HACK//UTEC">
    <Navbar/>
    <main>
        <Hero/>
        <Podium teams={results.podium}/>
        <TeamsList teams={results.teams} totalTeams={results.podium.length + results.teams.length}/>
    </main>
    <Footer/>
</Layout>
