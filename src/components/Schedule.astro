---
const schedule = [
    {
        day: "Día 1",
        date: "Sábado 21 de Junio",
        events: [
            { time: "06:00 PM", title: "Inicio del Reto", description: "Se revelará el desafío oficial y todos los equipos comienza oficialmente el desarrollo." },
        ]
    },
    {
        day: "Día 2",
        date: "Domingo 22 de Junio",
        events: [
            { time: "06:00 PM", title: "Fin del Reto", description: "Se cierra el tiempo de desarrollo. Los equipos deben entregar sus soluciones finales." },
        ]
    },
    {
        day: "Día 3",
        date: "Lunes 30 de Junio",
        events: [
            { time: "08:00 AM", title: "Premiación", description: "Se anunciarán los equipos ganadores y se entregarán los premios." },
        ]
    }
];
---

<section id="schedule" class="py-20 bg-black">
    <div class="container mx-auto px-4">
        <h2 class="text-5xl md:text-6xl font-bold mb-12 tracking-tighter text-center">
            <span class="gradient-text">Calendario</span>
        </h2>

        <div class="max-w-4xl mx-auto">
            <div class="justify-center flex overflow-x-auto gap-4 pb-4 mb-8 scrollbar-hide">
                { schedule.map((day, index) => (
                        <button
                                class="schedule-tab px-6 py-3 border border-white/20 min-w-[120px] text-center hover:bg-white/5 transition-colors"
                                data-tab={ index }
                                data-active={ index === 0 }
                        >
                            <div class="text-sm text-white/60">{ day.day }</div>
                            <div class="text-lg font-bold">{ day.date }</div>
                        </button>
                )) }
            </div>

            <div class="schedule-content">
                { schedule.map((day, index) => (
                        <div class="schedule-pane" data-pane={ index } data-active={ index === 0 }>
                            <div class="space-y-6">
                                { day.events.map(event => (
                                        <div class="flex gap-6 p-4 border border-white/10 hover:border-[#0066ff] transition-colors">
                                            <div class="text-lg font-mono text-[#0066ff] min-w-[100px]">{ event.time }</div>
                                            <div>
                                                <h4 class="text-xl font-bold">{ event.title }</h4>
                                                <p class="text-white/60">{ event.description }</p>
                                            </div>
                                        </div>
                                )) }
                            </div>
                        </div>
                )) }
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('.schedule-tab');
        const panes = document.querySelectorAll('.schedule-pane');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const tabIndex = tab.getAttribute('data-tab');

                // Update active tab
                tabs.forEach(t => t.setAttribute('data-active', 'false'));
                tab.setAttribute('data-active', 'true');

                // Update active pane
                panes.forEach(p => p.setAttribute('data-active', 'false'));
                document.querySelector(`.schedule-pane[data-pane="${ tabIndex }"]`).setAttribute('data-active', 'true');
            });
        });
    });
</script>

<style>
.schedule-tab[data-active="true"] {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: #0066ff;
    }

.schedule-pane {
    display: none;
    }

.schedule-pane[data-active="true"] {
    display: block;
    }

.scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
    }

.scrollbar-hide::-webkit-scrollbar {
    display: none;
    }
</style>
