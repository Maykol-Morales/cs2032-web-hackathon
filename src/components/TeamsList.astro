---
export interface Props {
    teams: Array<{
        key: string;
        name: string;
        score: number;
        github: string;
        solution: string;
        members: Array<{
            name: string;
            code: string;
            section: string;
            certificateUrl?: string;
            certificateFound?: boolean;
        }>;
    }>;
    totalTeams: number;
}

const { teams, totalTeams } = Astro.props;

function extractFirstUrl(text: string): string | null {
    const match = text.match(/https?:\/\/[^\s\)]+/);
    return match ? match[0] : null;
}
---

<section id="teams" class="py-24 relative border-t border-white/10">
    <div class="container mx-auto px-4">
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-black mb-4">
                <span class="gradient-text">Equipos Participantes</span>
            </h2>
            <p class="text-white/60 text-lg max-w-2xl mx-auto">
                {totalTeams} equipos completaron su solución durante HACK//UTEC Cloud Computing.
                Haz clic en un equipo para ver a sus integrantes y descargar sus certificados.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-7xl mx-auto">
            {teams.map((team) => (
                <button
                    type="button"
                    data-team={JSON.stringify(team)}
                    class="team-card group text-left w-full bg-white/5 hover:bg-white/10 border border-white/10 hover:border-[#0066ff]/50 rounded-xl p-6 transition-all duration-200"
                >
                    <div class="mb-4">
                        <h3 class="text-lg font-bold text-white leading-tight">{team.name}</h3>
                    </div>
                    <p class="text-white/50 text-sm mb-4">
                        {team.members.length} {team.members.length === 1 ? "integrante" : "integrantes"}
                    </p>
                    <div class="flex items-center text-[#0066ff] text-sm font-semibold group-hover:underline">
                        Ver integrantes
                        <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                    </div>
                </button>
            ))}
        </div>
    </div>
</section>

<!-- Modal único -->
<div
    id="team-modal"
    class="fixed inset-0 z-[60] hidden"
    aria-modal="true"
    role="dialog"
>
    <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" data-modal-backdrop></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="relative w-full max-w-xl bg-[#0a0a0a] border border-white/20 rounded-2xl shadow-2xl overflow-hidden">
            <div class="p-6 border-b border-white/10 flex items-start justify-between gap-4">
                <div>
                    <h3 id="modal-title" class="text-2xl font-bold text-white"></h3>
                    <p id="modal-score" class="text-[#00ccff] font-mono mt-1"></p>
                </div>
                <button
                    type="button"
                    data-modal-close
                    class="shrink-0 p-2 rounded-lg hover:bg-white/10 text-white/70 hover:text-white transition-colors"
                    aria-label="Cerrar"
                >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="p-6 max-h-[60vh] overflow-y-auto custom-scrollbar">
                <h4 class="text-sm font-bold text-white/50 uppercase tracking-wider mb-4">Integrantes</h4>
                <ul id="modal-members" class="space-y-3"></ul>


            </div>
        </div>
    </div>
</div>

<script is:inline>
    (function () {
        const modal = document.getElementById('team-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalScore = document.getElementById('modal-score');
        const modalMembers = document.getElementById('modal-members');
        const cards = document.querySelectorAll('.team-card');
        const closeBtn = modal.querySelector('[data-modal-close]');
        const backdrop = modal.querySelector('[data-modal-backdrop]');

                function openModal(team) {
            modalTitle.textContent = team.name;
            modalScore.textContent = `${team.members.length} ${team.members.length === 1 ? "integrante" : "integrantes"}`;

            modalMembers.innerHTML = team.members
                .map((member) => {
                    const certButton = member.certificateFound && member.certificateUrl
                        ? `<a href="${member.certificateUrl}" target="_blank" rel="noopener noreferrer" class="shrink-0 px-4 py-2 text-sm font-bold bg-[#0066ff] hover:bg-[#0052cc] text-white rounded transition-colors">Certificado</a>`
                        : `<span class="shrink-0 px-3 py-2 text-xs text-white/40 bg-white/5 rounded">Sin certificado</span>`;
                    return `
                        <li class="flex items-center justify-between gap-4 bg-white/5 rounded-lg p-4">
                            <div class="min-w-0">
                                <p class="font-semibold text-white truncate">${member.name}</p>
                                ${member.code ? `<p class="text-xs text-white/50">Código: ${member.code}</p>` : ''}
                            </div>
                            ${certButton}
                        </li>
                    `;
                })
                .join('');

            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }

        cards.forEach((card) => {
            card.addEventListener('click', () => {
                try {
                    const team = JSON.parse(card.dataset.team);
                    openModal(team);
                } catch (e) {
                    console.error('Error abriendo modal:', e);
                }
            });
        });

        closeBtn.addEventListener('click', closeModal);
        backdrop.addEventListener('click', closeModal);
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                closeModal();
            }
        });
    })();
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 3px;
    }
</style>
