                    <div class="flex items-center justify-center gap-3 mb-6">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-400">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22,4 12,14.01 9,11.01"></polyline>
                        </svg>
                        <h4 class="text-xl font-bold text-green-400">✅ Desafío completado con Éxito</h4>
                    </div>
                    <div class="flex flex-wrap justify-center gap-4">
                        { allTeams.successful.map((team, index) => (
                                <div class="team-card bg-gradient-to-br from-green-500/20 to-green-600/10 border border-green-500/30 p-4 cursor-pointer hover:border-green-500/50 transition-all w-full md:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.67rem)]" data-team={ `successful-${ index }` }>
                                    <div class="flex items-center justify-center gap-2 mb-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-400">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <h5 class="font-bold text-white/90">{ team.name }</h5>
                                    </div>
                                    <div class="text-sm text-white/60">Haz clic para ver a los participantes.</div>
                                </div>
                        )) }
                    </div>
                </div>

                <!-- Teams that Participated -->
                <div>
                    <div class="flex items-center justify-center gap-3 mb-6">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="m22 21-3-3m0 0a5 5 0 1 0-7-7 5 5 0 0 0 7 7Z"></path>
                        </svg>
                        <h4 class="text-xl font-bold text-blue-400">🎯 Participó en el Desafío</h4>
                    </div>
                    <div class="flex flex-wrap justify-center gap-4">
                        { allTeams.participating.map((team, index) => (
                                <div class="team-card bg-gradient-to-br from-blue-500/20 to-blue-600/10 border border-blue-500/30 p-4 cursor-pointer hover:border-blue-500/50 transition-all w-full md:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.67rem)]" data-team={ `participating-${ index }` }>
                                    <div class="flex items-center justify-center gap-2 mb-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="9" cy="7" r="4"></circle>
                                        </svg>
                                        <h5 class="font-bold text-white/90">{ team.name }</h5>
                                    </div>
                                    <div class="text-sm text-white/60">Haz clic para ver a los participantes.</div>
                                </div>
                        )) }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Team Details Modal -->
    <div id="teamModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
        <div class="bg-black border border-white/20 max-w-md w-full p-6 relative">
            <button id="closeModal" class="absolute top-4 right-4 text-white/60 hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m18 6-12 12"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </button>

            <h3 id="modalTeamName" class="text-2xl font-bold mb-4 text-[#0066ff]"></h3>
            <h4 class="text-lg font-bold mb-3 text-white/80">Miembros:</h4>
            <div id="modalParticipants" class="space-y-2">
                <!-- Participants will be populated here -->
            </div>
        </div>
    </div>
</section>

<script define:vars={ { allTeams } }>
    document.addEventListener('DOMContentLoaded', () => {
        // Use the same data structure from Astro
        const teamData = {};

        // Build teamData from allTeams
        teamData['winner-first'] = allTeams.winners.first;
        teamData['winner-second'] = allTeams.winners.second;
        teamData['winner-third'] = allTeams.winners.third;

        allTeams.finalists.forEach((team, index) => {
            teamData[`finalist-${ index }`] = team;
        });

        allTeams.successful.forEach((team, index) => {
            teamData[`successful-${ index }`] = team;
        });

        allTeams.participating.forEach((team, index) => {
            teamData[`participating-${ index }`] = team;
        });

        const modal = document.getElementById('teamModal');
        const modalTeamName = document.getElementById('modalTeamName');
        const modalParticipants = document.getElementById('modalParticipants');
        const closeModal = document.getElementById('closeModal');

        // Add click listeners to all team cards
        document.querySelectorAll('.team-card').forEach(card => {
            card.addEventListener('click', () => {
                const teamId = card.getAttribute('data-team');
                const team = teamData[teamId];

                if (team) {
                    modalTeamName.textContent = team.name;
                    modalParticipants.innerHTML = '';

                    team.participants.forEach(participant => {
                        const participantDiv = document.createElement('div');
                        participantDiv.className = 'p-3 border border-white/10 bg-white/5 hover:bg-white/10 transition-colors cursor-pointer';
                        participantDiv.innerHTML = `
              <div class="flex items-center justify-between">
                <span class="text-white/90">${ participant.name }</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#0066ff]">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7,10 12,15 17,10"></polyline>
                  <line x1="12" x2="12" y1="15" y2="3"></line>
                </svg>
              </div>
            `;

                        participantDiv.addEventListener('click', () => {
                            // Create a temporary link to download the certificate
                            const link = document.createElement('a');
                            link.href = participant.certificateUrl;
                            link.download = `${ participant.name }_Certificate.pdf`;
                            link.target = '_blank';
                            document.body.appendChild(link);
                            link.click();
                            document.body.removeChild(link);
                        });

                        modalParticipants.appendChild(participantDiv);
                    });

                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                }
            });
        });

        // Close modal
        closeModal.addEventListener('click', () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        });

        // Close modal when clicking outside
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        });
    });
</script>
