---
const acceptedTeams = [
    "Los Sipser",
    "EQUIPO ALFA BUENA MARAVILLA ONDA DINAMITA ESCUADRON LOBO 1",
    "Todo va a estar Bien",
    "Monarchs of the Cloud",
    "Gpteros",
    "aws lovers",
    "Seguidores de Omejia",
    "RosExp2030",
    "75 puntazos",
    "Batifamilia",
    "HackaCloud",
    "AlfaMegaMaravillabombaprox",
    "Mother Nature's Sons",
    "equipo alfa buena maravilla onda dinamita escuadrón lobo 2",
    "Rimac",
    "Time Bomb",
    "S3ñores del Front",
    "OnlyUML",
    "GopherWarriors",
    "ABC"
];
---

<section id="register" class="py-20 bg-black relative">
    <div class="absolute inset-0 z-0">
        <div class="h-full w-full bg-[linear-gradient(to_bottom_right,rgba(0,102,255,0.1),rgba(0,204,255,0.1))]"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-5xl md:text-6xl font-bold mb-6 tracking-tighter">
                <span class="gradient-text">Inscripciones cerradas</span>
            </h2>

            <p class="text-xl text-white/80 mb-8 max-w-xl mx-auto">
                ¡Gracias por tu interés! Las inscripciones para HACK//UTEC 2025 se han cerrado oficialmente. Aquí están los equipos aceptados:
            </p>

            <!-- Registration Status -->
            <div class="bg-red-500/10 border border-red-500/30 p-4 mb-8 inline-block">
                <div class="flex items-center justify-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-400">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="m15 9-6 6"></path>
                        <path d="m9 9 6 6"></path>
                    </svg>
                    <span class="text-red-400 font-bold">Periodo de inscripción finalizado</span>
                </div>
            </div>

            <!-- Accepted Teams -->
            <div class="bg-black/50 backdrop-blur-sm border border-white/10 p-8 mb-8">
                <h3 class="text-2xl font-bold mb-6 text-[#0066ff]">Equipos aceptados ({acceptedTeams.length})</h3>

                <div class="flex flex-wrap justify-center gap-4 text-left">
                    {acceptedTeams.map((team, index) => (
                            <div class="flex items-center gap-3 p-3 border border-white/10 bg-white/5 hover:bg-white/10 transition-colors w-full md:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.67rem)]">
                                <div class="w-8 h-8 rounded-full bg-[#0066ff]/20 flex items-center justify-center flex-shrink-0">
                                    <span class="text-[#0066ff] font-bold text-sm">{index + 1}</span>
                                </div>
                                <span class="text-white/90 text-sm">{team}</span>
                            </div>
                    ))}
                </div>
            </div>

            <!-- Next Steps -->
            <div class="p-6 border border-[#0066ff]/30 bg-[#0066ff]/10">
                <h4 class="text-xl font-bold mb-2">Próximos pasos para los equipos aceptados</h4>
                <p class="text-white/80 mb-4">
                    Los equipos aceptados deben unirse a la inauguración por Zoom a las 6:00 PM., donde revelaremos el reto y brindaremos toda la información necesaria.
                </p>
                <div class="text-sm text-white/60">
                    <strong>Hora:</strong> Junio 21 6:00 PM, 2025
                </div>
            </div>
        </div>
    </div>
</section>
