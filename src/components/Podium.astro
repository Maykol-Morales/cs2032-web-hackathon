---
export interface Props {
    teams: Array<{
        position: number;
        name: string;
        score: number;
        members: Array<{
            name: string;
            code: string;
            section: string;
            certificateUrl?: string;
            certificateFound?: boolean;
        }>;
    }>;
}

const { teams } = Astro.props;

const ordered = [1, 2, 3]
    .map((pos) => teams.find((t) => t.position === pos))
    .filter(Boolean) as Props["teams"];

const rankStyles: Record<
    number,
    {
        border: string;
        badgeBg: string;
        badgeText: string;
        shadow: string;
        iconColor: string;
        order: string;
    }
> = {
    1: {
        border: "border-yellow-400/60",
        badgeBg: "bg-yellow-400",
        badgeText: "text-black",
        shadow: "shadow-yellow-400/10",
        iconColor: "text-yellow-400",
        order: "order-1 md:order-2",
    },
    2: {
        border: "border-slate-300/50",
        badgeBg: "bg-slate-300",
        badgeText: "text-black",
        shadow: "shadow-slate-300/10",
        iconColor: "text-slate-300",
        order: "order-2 md:order-1",
    },
    3: {
        border: "border-amber-600/60",
        badgeBg: "bg-amber-600",
        badgeText: "text-white",
        shadow: "shadow-amber-600/10",
        iconColor: "text-amber-600",
        order: "order-3 md:order-3",
    },
};

const rankLabels: Record<number, string> = {
    1: "1er lugar",
    2: "2do lugar",
    3: "3er lugar",
};
---

<section id="podium" class="py-20 relative">
    <div class="container mx-auto px-4">
        <div class="text-center mb-14">
            <h2 class="text-4xl md:text-5xl font-black mb-4">
                <span class="gradient-text">Podio de Ganadores</span>
            </h2>
            <p class="text-white/60 text-lg max-w-2xl mx-auto">
                Reconocimiento a los equipos ganadores de HACK//UTEC Cloud Computing.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto items-stretch">
            {ordered.map((team) => {
                const style = rankStyles[team.position];
                const isFirst = team.position === 1;
                return (
                    <div class={`${style.order} ${isFirst ? "md:-translate-y-4" : ""}`}>
                        <div
                            class={`h-full flex flex-col bg-[#0d0d0d] border ${style.border} rounded-2xl p-6 shadow-lg ${style.shadow}`}
                        >
                            <div class="text-center mb-5">
                                <div class={`inline-flex items-center justify-center w-14 h-14 rounded-full ${style.badgeBg} ${style.badgeText} mb-4`}>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z" />
                                    </svg>
                                </div>
                                <span class={`block text-xs font-bold uppercase tracking-widest mb-2 ${style.iconColor}`}>
                                    {rankLabels[team.position]}
                                </span>
                                <h3 class="text-xl md:text-2xl font-bold text-white leading-tight">{team.name}</h3>
                            </div>

                            <div class="flex-1 space-y-2.5">
                                {team.members.map((member) => (
                                    <div class="flex items-center justify-between gap-3 bg-white/5 hover:bg-white/[0.07] rounded-xl px-4 py-3 transition-colors">
                                        <div class="min-w-0">
                                            <p class="font-semibold text-white text-sm truncate">{member.name}</p>
                                            {member.code && (
                                                <p class="text-xs text-white/50">{member.code}</p>
                                            )}
                                        </div>
                                        {member.certificateFound && member.certificateUrl ? (
                                            <a
                                                href={member.certificateUrl}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="shrink-0 px-3 py-1.5 text-xs font-bold bg-[#0066ff] hover:bg-[#0052cc] text-white rounded transition-colors"
                                            >
                                                Certificado
                                            </a>
                                        ) : (
                                            <span class="shrink-0 text-xs text-white/40">Sin certificado</span>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                );
            })}
        </div>
    </div>
</section>
