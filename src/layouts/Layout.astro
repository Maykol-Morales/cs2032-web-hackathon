---
const { title } = Astro.props;
import "../styles/global.css"
---

<!doctype html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8"/>
    <meta name="description" content="UTEC Hackathon 2025 - Transformando ideas en soluciones innovadoras para el desarrollo sostenible del Perú"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="icon" type="image/svg+xml" href="/logo.webp"/>
    <meta name="generator" content={ Astro.generator }/>
    <title>{ title }</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="font-sans antialiased">
<slot/>
</body>
</html>

<style is:global>
    :root {
        --utec-blue: #003B71;
        --utec-blue-light: #0056a4;
        --utec-blue-dark: #002548;
    }

    html {
        font-family: 'Inter', system-ui, sans-serif;
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        line-height: 1.6;
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    ::-webkit-scrollbar-thumb {
        background: var(--utec-blue);
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: var(--utec-blue-dark);
    }

    /* Hero Animations and Effects */
    @keyframes float {
        0%   { transform: translateY(0) translateX(0) scale(1) rotate(0deg); }
        50%  { transform: translateY(-20px) translateX(5px) scale(1.1) rotate(5deg); }
        100% { transform: translateY(0) translateX(0) scale(1) rotate(0deg); }
    }

    @keyframes float-reverse {
        0%   { transform: translateY(0) translateX(0) scale(1) rotate(0deg); }
        50%  { transform: translateY(20px) translateX(-5px) scale(0.95) rotate(-5deg); }
        100% { transform: translateY(0) translateX(0) scale(1) rotate(0deg); }
    }

    @keyframes drift {
        0%   { transform: translate(0, 0) rotate(0deg) scale(1); }
        50%  { transform: translate(10px, -10px) rotate(3deg) scale(1.05); }
        100% { transform: translate(0, 0) rotate(0deg) scale(1); }
    }

    @keyframes fade-in-up {
        0% {
            opacity: 0;
            transform: translateY(30px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes gradient-shift {
        0%, 100% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
    }

    @keyframes pulse-glow {
        0%, 100% {
            text-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
        }
        50% {
            text-shadow: 0 0 40px rgba(59, 130, 246, 0.8);
        }
    }

    @keyframes pulse-slow {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }

    /* Particles */
    .particle {
        position: absolute;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
    }

    .particle-1 {
        width: 8px;
        height: 8px;
        top: 20%;
        left: 10%;
        animation-delay: 0s;
    }

    .particle-2 {
        width: 12px;
        height: 12px;
        top: 60%;
        left: 80%;
        animation: float-reverse 8s ease-in-out infinite;
        animation-delay: 1s;
    }

    .particle-3 {
        width: 6px;
        height: 6px;
        top: 80%;
        left: 20%;
        animation-delay: 2s;
    }

    .particle-4 {
        width: 10px;
        height: 10px;
        top: 30%;
        left: 70%;
        animation: float-reverse 7s ease-in-out infinite;
        animation-delay: 3s;
    }

    .particle-5 {
        width: 14px;
        height: 14px;
        top: 10%;
        left: 60%;
        animation-delay: 4s;
    }

    .particle-6 {
        width: 8px;
        height: 8px;
        top: 70%;
        left: 40%;
        animation: float-reverse 9s ease-in-out infinite;
        animation-delay: 5s;
    }

    /* Floating Code Elements - Enhanced */
    .code-float {
        position: absolute;
        color: rgba(255, 255, 255, 0.12);
        font-family: 'Courier New', monospace;
        font-weight: 500;
        white-space: nowrap;
        opacity: 0; /* Start invisible */
    }

    /* Different sizes for variety */
    .code-1, .code-6, .code-11, .code-16 {
        font-size: 16px;
    }

    .code-2, .code-7, .code-12, .code-17 {
        font-size: 14px;
    }

    .code-3, .code-8, .code-13, .code-18 {
        font-size: 12px;
    }

    .code-4, .code-9, .code-14 {
        font-size: 18px;
    }

    .code-5, .code-10, .code-15 {
        font-size: 13px;
    }

    /* Reduced delays - all start within 18 seconds */
    .code-1 {
        top: 10%;
        animation: drift-fast 30s linear infinite;
        animation-delay: 0s;
    }

    .code-2 {
        top: 20%;
        animation: drift-reverse 15s linear infinite;
        animation-delay: 1s;
    }

    .code-3 {
        top: 30%;
        animation: drift-fast 30s linear infinite;
        animation-delay: 2s;
    }

    .code-4 {
        top: 40%;
        animation: drift-reverse 15s linear infinite;
        animation-delay: 3s;
    }

    .code-5 {
        top: 50%;
        animation: drift-fast 30s linear infinite;
        animation-delay: 4s;
    }

    .code-6 {
        top: 60%;
        animation: drift-reverse 15s linear infinite;
        animation-delay: 5s;
    }

    .code-7 {
        top: 70%;
        animation: drift-fast 30s linear infinite;
        animation-delay: 6s;
    }

    .code-8 {
        top: 80%;
        animation: drift-reverse 15s linear infinite;
        animation-delay: 7s;
    }

    .code-9 {
        top: 15%;
        animation: drift-fast 30s linear infinite;
        animation-delay: 8s;
    }

    .code-10 {
        top: 25%;
        animation: drift-reverse 15s linear infinite;
        animation-delay: 9s;
    }

    .code-11 {
        top: 35%;
        animation: drift-fast 30s linear infinite;
        animation-delay: 10s;
    }

    .code-12 {
        top: 45%;
        animation: drift-reverse 15s linear infinite;
        animation-delay: 11s;
    }

    .code-13 {
        top: 55%;
        animation: drift-fast 30s linear infinite;
        animation-delay: 12s;
    }

    .code-14 {
        top: 65%;
        animation: drift-reverse 15s linear infinite;
        animation-delay: 13s;
    }

    .code-15 {
        top: 75%;
        animation: drift-fast 30s linear infinite;
        animation-delay: 14s;
    }

    .code-16 {
        top: 85%;
        animation: drift-reverse 15s linear infinite;
        animation-delay: 15s;
    }

    .code-17 {
        top: 18%;
        animation: drift-fast 30s linear infinite;
        animation-delay: 16s;
    }

    .code-18 {
        top: 38%;
        animation: drift-reverse 15s linear infinite;
        animation-delay: 17s;
    }

    /* Updated drift animations with proper opacity transitions */
    @keyframes drift {
        0% {
            transform: translateX(-100px) translateY(0px);
            opacity: 0;
        }
        5% {
            opacity: 1;
        }
        95% {
            opacity: 1;
        }
        100% {
            transform: translateX(calc(100vw + 100px)) translateY(-100px);
            opacity: 0;
        }
    }

    @keyframes drift-slow {
        0% {
            transform: translateX(-150px) translateY(0px) rotate(0deg);
            opacity: 0;
        }
        3% {
            opacity: 1;
        }
        97% {
            opacity: 1;
        }
        100% {
            transform: translateX(calc(100vw + 150px)) translateY(-50px) rotate(5deg);
            opacity: 0;
        }
    }

    @keyframes drift-fast {
        0% {
            transform: translateX(-100px) translateY(0px) rotate(0deg);
            opacity: 0;
        }
        8% {
            opacity: 1;
        }
        92% {
            opacity: 1;
        }
        100% {
            transform: translateX(calc(100vw + 100px)) translateY(-80px) rotate(-3deg);
            opacity: 0;
        }
    }

    @keyframes drift-reverse {
        0% {
            transform: translateX(calc(100vw + 100px)) translateY(0px) rotate(0deg);
            opacity: 0;
        }
        3% {
            opacity: 1;
        }
        97% {
            opacity: 1;
        }
        100% {
            transform: translateX(-150px) translateY(50px) rotate(-5deg);
            opacity: 0;
        }
    }

    /* Add subtle glow effect to some code elements */
    .code-1, .code-4, .code-9, .code-14 {
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    }

    /* Special styling for comments and important code */
    .code-13 {
        color: rgba(34, 197, 94, 0.15); /* Green for comments */
        font-style: italic;
    }

    .code-4, .code-9 {
        color: rgba(59, 130, 246, 0.15); /* Blue for important code */
        font-weight: 600;
    }

    .code-7, .code-8 {
        color: rgba(168, 85, 247, 0.15); /* Purple for commands */
    }

    /* Geometric Shapes */
    .geometric-shape {
        position: absolute;
        border: 2px solid rgba(255, 255, 255, 0.1);
        animation: float 10s ease-in-out infinite;
    }

    .shape-1 {
        width: 60px;
        height: 60px;
        top: 20%;
        right: 15%;
        transform: rotate(45deg);
        animation-delay: 0s;
    }

    .shape-2 {
        width: 40px;
        height: 40px;
        top: 60%;
        left: 15%;
        border-radius: 50%;
        animation: float-reverse 12s ease-in-out infinite;
        animation-delay: 2s;
    }

    .shape-3 {
        width: 80px;
        height: 80px;
        bottom: 20%;
        right: 25%;
        clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
        background: rgba(255, 255, 255, 0.05);
        border: none;
        animation-delay: 4s;
    }

    .shape-4 {
        width: 50px;
        height: 50px;
        top: 40%;
        right: 40%;
        transform: rotate(30deg);
        animation: float-reverse 8s ease-in-out infinite;
        animation-delay: 6s;
    }

    /* Grid Pattern */
    .grid-pattern {
        width: 100%;
        height: 100%;
        background-image: linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
        background-size: 50px 50px;
        animation: drift 30s linear infinite;
    }

    /* Content Animations */
    .animate-fade-in-up {
        animation: fade-in-up 1s ease-out forwards;
    }

    .animation-delay-300 {
        animation-delay: 0.3s;
        opacity: 0;
    }

    .animation-delay-600 {
        animation-delay: 0.6s;
        opacity: 0;
    }

    .animation-delay-900 {
        animation-delay: 0.9s;
        opacity: 0;
    }

    .animate-bounce-slow {
        animation: float 4s ease-in-out infinite;
    }

    .animate-pulse-slow {
        animation: pulse-glow 3s ease-in-out infinite;
    }

    .animate-gradient {
        background: linear-gradient(-45deg, #ffffff, #bfdbfe, #93c5fd, #60a5fa);
        background-size: 400% 400%;
        animation: gradient-shift 4s ease infinite;
    }

    /* Info Cards */
    .info-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 1rem 1.5rem;
        transition: all 0.3s ease;
        min-width: 140px;
    }

    .info-card:hover {
        background: rgba(255, 255, 255, 0.15);
        transform: translateY(-5px);
    }

    /* CTA Button */
    .cta-button {
        display: inline-block;
        background: linear-gradient(135deg, #ffffff, #f3f4f6);
        color: var(--utec-blue);
        font-weight: bold;
        padding: 1rem 2rem;
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .cta-button:hover {
        background: linear-gradient(135deg, #f9fafb, #e5e7eb);
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
        .code-float {
            font-size: 8px !important;
        }

        .geometric-shape {
            display: none;
        }

        .particle {
            width: 4px !important;
            height: 4px !important;
        }

        .info-card {
            min-width: auto;
            padding: 0.75rem 1rem;
        }
    }

    @media (max-width: 640px) {
        .code-float {
            font-size: 6px !important;
        }
    }
</style>
